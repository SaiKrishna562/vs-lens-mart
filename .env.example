# Copy of the variable names only. `npm run db:setup` writes the real values to
# .env.local (gitignored). Never commit real values.
DATABASE_URL_OWNER=postgresql://vslm_owner:<password>@localhost:5432/vslm_dev
DATABASE_URL_APP=postgresql://vslm_app:<password>@localhost:5432/vslm_dev
DATABASE_URL_AUTH=postgresql://vslm_auth:<password>@localhost:5432/vslm_dev
BETTER_AUTH_SECRET=<32+ random characters>
BETTER_AUTH_URL=http://localhost:3000
